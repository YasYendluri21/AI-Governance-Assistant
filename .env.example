# --- LLM ---------------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run against the deterministic mock provider.
# The whole app works offline that way; set a key to use Claude for real.
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto          # auto | claude | mock
LLM_MODEL=claude-opus-5

# --- API ---------------------------------------------------------------------
PORT=4000
DATABASE_PATH=./data/governance.db

# --- AWS (optional) -----------------------------------------------------------
# When set, immutable audit records are archived to S3 on policy execution.
# Unset, archival is skipped and the run notes that in its event log.
AUDIT_ARCHIVE_BUCKET=
AWS_REGION=us-east-1
